[Unit]
Description=Metis Microsoft SQL Server TDS honeypot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=metis-tds
Group=metis-tds
ExecStart=/usr/local/bin/metis-tds --config /etc/metis-tds/config.json
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/etc/metis-tds
ReadWritePaths=/var/lib/metis-tds/payloads /var/log/metis-tds
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
